{
  "name": "shopeasy-api-automation",
  "version": "1.0.0",
  "description": "API automation test suite for ShopEasy Order Management API using Playwright",
  "scripts": {
    "pretest": "node -e \"const fs=require('fs');['reports/html-report','reports/json-report','reports/coverage-report','test-artifacts/playwright-output'].forEach(d=>fs.mkdirSync(d,{recursive:true}))\"",
    "test": "playwright test",
    "test:auth": "playwright test tests/auth",
    "test:products": "playwright test tests/products",
    "test:cart": "playwright test tests/cart",
    "test:orders": "playwright test tests/orders",
    "test:payments": "playwright test tests/payments",
    "test:e2e": "playwright test tests/e2e",
    "test:ci": "CI=true playwright test",
    "report:html": "playwright show-report reports/html-report",
    "report:coverage": "ts-node scripts/coverage-report.ts"
  },
  "keywords": ["playwright", "api-testing", "automation", "shopeasy"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
